        <!-- SECURITY & STATE MANAGEMENT ENGINE -->
        <mxCell id="sec_engine" value="&lt;b&gt;SECURITY &amp; STATE MANAGEMENT ENGINE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px;color:#64748B;&quot;&gt;Platform Governance, Encryption &amp; Handshake Security&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#4F46E5;strokeWidth=2;align=center;verticalAlign=top;spacingTop=16;fontSize=15;fontColor=#1F2937;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1140" y="390" width="470" height="440" as="geometry" />
        </mxCell>
        
        <mxCell id="sec1" value="&lt;b&gt;• Stateless JWT Authentication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:10px;&quot;&gt;Cryptographic token-based authorization via Bearer headers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#312E81;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="444" width="434" height="47" as="geometry" />
        </mxCell>
        <mxCell id="sec2" value="&lt;b&gt;• Bcrypt Password Hashing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:10px;&quot;&gt;Salted cryptographic one-way hashing for user credentials&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#312E81;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="497" width="434" height="47" as="geometry" />
        </mxCell>
        <mxCell id="sec3" value="&lt;b&gt;• Role-Based Access Control (RBAC)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:10px;&quot;&gt;Endpoint guards restricting donor, ngo, volunteer &amp; admin actions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#312E81;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="550" width="434" height="47" as="geometry" />
        </mxCell>
        <mxCell id="sec4" value="&lt;b&gt;• Finite State Machine (FSM) Lifecycle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#92400E;font-size:10px;&quot;&gt;Strict sequencing: Available -&gt; Requested -&gt; Accepted -&gt; Picked Up -&gt; Delivered&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="603" width="434" height="47" as="geometry" />
        </mxCell>
        <mxCell id="sec5" value="&lt;b&gt;• Digital Handshake Physical Verification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#065F46;font-size:10px;&quot;&gt;Dual 4-digit OTP: Donor Pickup OTP &amp; NGO Delivery OTP&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="656" width="434" height="47" as="geometry" />
        </mxCell>
        <mxCell id="sec6" value="&lt;b&gt;• Input Sanitization &amp; Boundary Guards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:10px;&quot;&gt;Mutation-killer validation preventing unauthorized payload injection&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#1E293B;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="709" width="434" height="47" as="geometry" />
        </mxCell>
        <mxCell id="sec7" value="&lt;b&gt;• Administrative Governance &amp; Audit Logs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:10px;&quot;&gt;Platform-wide traceability and real-time verification logs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#1E293B;align=left;spacingLeft=15;fontSize=12;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1158" y="762" width="434" height="47" as="geometry" />
